# Production env for /home/foundry/c7d5a6l (PM2 run.sh sources this).
# Copy to .env on the server and fill in. Deploy never overwrites .env.

C7D5A6L_DB=data/app.sqlite

# Telegram Login Widget (BotFather). Domain must be league.c7d5a6.com
C7D5A6L_TELEGRAM_BOT_TOKEN=
C7D5A6L_TELEGRAM_BOT_ID=
C7D5A6L_TELEGRAM_BOT_USERNAME=

# openssl rand -hex 32
C7D5A6L_JWT_SECRET=
C7D5A6L_JWT_TTL=168h

# Comma-separated Telegram user ids that get ADMIN on first login
C7D5A6L_ADMIN_TELEGRAM_IDS=

# Optional extra CORS origins (https://league.c7d5a6.com is already allowed in code)
# C7D5A6L_CORS_ORIGIN=

# C7D5A6L_DEBUG=0
