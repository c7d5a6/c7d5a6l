# Copy to backend/.env and fill in. Gitignored. `make dev` / `make server` source this.
# Production: same keys in /home/foundry/c7d5a6l/.env (deploy never overwrites that file).

# Local default. Production typically uses data/app.sqlite
C7D5A6L_DB=devdata/app.sqlite

# Telegram Login Widget (BotFather).
# Local domain: c7d5a6l.lo   Production: league.c7d5a6.com
C7D5A6L_TELEGRAM_BOT_TOKEN=
C7D5A6L_TELEGRAM_BOT_ID=
C7D5A6L_TELEGRAM_BOT_USERNAME=

# openssl rand -hex 32
C7D5A6L_JWT_SECRET=
C7D5A6L_JWT_TTL=168h

# Comma-separated Telegram user ids that get ADMIN on first login
C7D5A6L_ADMIN_TELEGRAM_IDS=

# Optional extra CORS origins (localhost, c7d5a6l.lo, league.c7d5a6.com are already allowed)
# C7D5A6L_CORS_ORIGIN=

# make dev forces C7D5A6L_DEBUG=1 even if this is 0
# C7D5A6L_DEBUG=0
